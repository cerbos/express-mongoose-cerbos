{
  "name": "express-mongoose-cerbos",
  "description": "",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch 'src/**' --ext 'ts,json' --ignore 'src/**/*.spec.ts' --exec 'node --loader ts-node/esm src/index.ts'",
    "test": "cerbos run --log-level=error --set=storage.disk.directory=./cerbos/policies --set=telemetry.disabled=true -- vitest run",
    "mongo": "docker run --rm --name mongodb -p 27017:27017 mongo:latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerbos/express-mongoose-cerbos.git"
