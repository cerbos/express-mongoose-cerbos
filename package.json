  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/http-auth": "^4.1.4",
    "@types/node": "^26.0.1",
    "@types/supertest": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@cerbos/grpc": "^0.29.0",
    "@cerbos/orm-mongoose": "^2.1.0",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
